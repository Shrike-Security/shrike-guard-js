{
  "name": "shrike-guard",
  "version": "4.2.0",
  "description": "Shrike SDK for AI agent action governance \u2014 drop-in wrapper for OpenAI, Anthropic, and Gemini that governs every tool call, prompt, and response server-side. Allow / approve / block. Free tier available.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "import": "./dist/openai/index.mjs",
      "require": "./dist/openai/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic/index.d.ts",
      "import": "./dist/anthropic/index.mjs",
      "require": "./dist/anthropic/index.js"
    },
    "./gemini": {
      "types": "./dist/gemini/index.d.ts",
      "import": "./dist/gemini/index.mjs",
      "require": "./dist/gemini/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.mjs",
      "require": "./dist/api/index.js"
    },
    "./claude-agent": {
      "types": "./dist/claude-agent/index.d.ts",
      "import": "./dist/claude-agent/index.mjs",
      "require": "./dist/claude-agent/index.js"
    },
    "./openai-agents": {
      "types": "./dist/openai-agents/index.d.ts",
      "import": "./dist/openai-agents/index.mjs",
      "require": "./dist/openai-agents/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.mjs",
      "require": "./dist/ai/index.js"
    },
    "./langchain": {
      "types": "./dist/langchain/index.d.ts",
      "import": "./dist/langchain/index.mjs",
      "require": "./dist/langchain/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "action-governance",
    "ai-agents",
    "agent-security",
    "agent-governance",
    "tool-call-gating",
    "ai-governance",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "llm",
    "prompt-injection",
    "pii",
    "jailbreak",
    "ai-safety",
    "claude-agent-sdk",
    "openai-agents",
    "vercel-ai-sdk",
    "langchain",
    "langgraph",
    "agent-framework"
  ],
  "author": "Shrike Security <security@shrikesecurity.com>",
  "license": "Apache-2.0",
  "homepage": "https://shrikesecurity.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shrike-Security/shrike-guard-js"
  },
  "bugs": {
    "url": "https://github.com/Shrike-Security/shrike-guard-js/issues"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.18.0",
    "@google/genai": ">=1.0.0",
    "openai": ">=4.0.0",
    "@anthropic-ai/claude-agent-sdk": ">=0.1.0",
    "@openai/agents": ">=0.1.0",
    "ai": ">=5.0.0",
    "langchain": ">=1.0.0",
    "@langchain/core": ">=1.0.0",
    "zod": ">=3.23.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "langchain": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@google/genai": "^2.12.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "openai": "^7.15.0",
    "ts-jest": "^29.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "@anthropic-ai/claude-agent-sdk": "^0.3.273",
    "@openai/agents": "^0.18.0",
    "ai": "^7.0.102",
    "langchain": "^1.5.11",
    "@langchain/core": "^1.1.0",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
